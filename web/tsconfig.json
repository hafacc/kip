{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    // Nothing references bun-types, and without it the `bun:test` imports fail
    // to resolve. `node` rides along as a bun-types dependency; naming it keeps
    // the scripts' `process`/`Buffer` independent of that.
    "types": ["$app/types", "bun", "node", "unplugin-icons/types/svelte"],
    "strict": true
  },
  "include": ["src", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"]
}
