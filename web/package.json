{
  "private": true,
  "name": "kip-web",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "dev:emulated": "firebase emulators:exec --config ../firebase.json --only auth,firestore --project demo-kip 'VITE_AUTH_EMULATOR=1 vite dev --port 3001 --strictPort'",
    "check:portal": "node scripts/portal-check.mjs",
    "export": "vite build",
    "fmt": "biome check --write",
    "lint": "svelte-kit sync && svelte-check --fail-on-warnings && tsc --noEmit -p tsconfig.sw.json && biome check && tsc --noEmit -p ../functions",
    "test": "bun test --path-ignore-patterns '**/rules.test.ts'",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore,auth --project demo-kip-rules 'bun test tests/rules.test.ts'",
    "check:host": "node scripts/host-check.mjs",
    "check:leave": "node scripts/leave-check.mjs",
    "check:consent": "node scripts/consent-check.mjs",
    "check:exif": "node scripts/exif-check.mjs",
    "check:teardown": "npm --prefix ../functions run build && firebase emulators:exec --config ../firebase.json --only auth,firestore,functions --project demo-kip 'node scripts/teardown-check.mjs'",
    "check:pwa": "node scripts/pwa-check.mjs",
    "check:feedback": "node scripts/feedback-check.mjs",
    "feedback": "bun run scripts/feedback.ts",
    "admin": "bun run scripts/admin.ts",
    "build:sw": "tsc -p tsconfig.sw.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/lucide": "^1.2.141",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "geofire-common": "^6.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.3"
  }
}
