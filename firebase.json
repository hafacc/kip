{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "hosting": {
    "public": "firebase/hosting",
    "redirects": [
      {
        "source": "/",
        "destination": "https://kip.hafa.cc/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://kip.hafa.cc/:path",
        "type": 301
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "*.log"
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "auth": {
      "port": 9099
    }
  }
}
